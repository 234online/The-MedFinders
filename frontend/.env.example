# Copy this file to ".env" (same folder) and fill in your Auth0 values.
# Auth0 Dashboard -> Applications -> your app -> Settings
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=paste-your-client-id-here

# Optional: live opening hours from Google (see README)
# VITE_GOOGLE_MAPS_KEY=

# Optional: AI chat assistant. ONE key is enough. These have NO "VITE_"
# prefix on purpose: they stay on the server and never reach the browser.
# Google Gemini (key from aistudio.google.com):
# GEMINI_API_KEY=...
# GEMINI_MODEL=gemini-flash-latest
# Anthropic Claude (key from console.anthropic.com):
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-sonnet-5-5
# If both keys are set, choose one (default gemini):
# AI_PROVIDER=gemini

# --- Voice for the chatbot (ElevenLabs) ---
# Key from elevenlabs.io → Developers → API Keys. Server-side only, no VITE_ prefix.
ELEVENLABS_API_KEY=
# Optional: another voice (copy its ID from the ElevenLabs Voice Library)
# ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
