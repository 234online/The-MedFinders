# Copy this file to ".env" (same folder) and fill in your Auth0 values.
# Auth0 Dashboard -> Applications -> your app -> Settings
VITE_AUTH0_DOMAIN=your-tenant.eu.auth0.com
VITE_AUTH0_CLIENT_ID=paste-your-client-id-here
# Auth0 Dashboard -> Applications -> APIs -> your API -> Identifier
VITE_AUTH0_AUDIENCE=https://api.medfinders

# Backend on Render (favourites + contact history are saved there).
# Locally: http://localhost:5000
VITE_API_URL=https://your-backend.onrender.com

# Optional: live opening hours from Google (see README)
# VITE_GOOGLE_MAPS_KEY=

# Optional: AI chat assistant (Claude). Get a key at console.anthropic.com
# This one has NO "VITE_" prefix on purpose: it stays on the server.
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-haiku-5-5
