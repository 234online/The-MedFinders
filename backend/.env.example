# Portul pe care rulează serverul Node.js backend
PORT=5000

# URL-ul aplicației frontend (Vite rulează implicit pe 5173)
FRONTEND_URL=http://localhost:5173

# Tipul sursei de date:
# - "json" : folosește fișierul local data/places.json (implicit în acest moment)
# - "mongodb" : va folosi MongoDB când se implementează
# - "postgres" : va folosi PostgreSQL când se implementează
DB_TYPE=json

# Placeholder pentru connection string-ul bazei de date (când va fi aleasă)
# DATABASE_URL=mongodb://localhost:27017/medfinders
# DATABASE_URL=postgresql://user:password@localhost:5432/medfinders
