# Copiați acest fișier în ".env" (local) sau puneți aceleași variabile în
# Render -> serviciul backend -> Environment.

# Portul serverului (Render îl setează singur, nu-l adăugați acolo)
PORT=5000

# Adresele frontend-ului, separate prin virgulă (local + Vercel)
FRONTEND_URL=http://localhost:5173,https://your-app.vercel.app

# Clinicile vin din database/timisoara_clinics.sql (fișier JSON generat)
DB_TYPE=json

# PostgreSQL pe Render (utilizatori, clinici favorite, istoric contactări).
# Render -> baza de date -> Connections:
#   - pe Render folosiți "Internal Database URL"
#   - local folosiți "External Database URL"
DATABASE_URL=postgresql://user:password@host/dbname
# DATABASE_SSL=true   # opțional: forțează SSL pornit (true) sau oprit (false)

# Auth0 -> Applications -> APIs -> API-ul vostru
AUTH0_DOMAIN=your-tenant.eu.auth0.com
AUTH0_AUDIENCE=https://api.medfinders

# Cheie secretă pentru rutele care modifică clinicile (POST/PUT/DELETE /api/places, /api/sync).
# Trimisă în header-ul "x-admin-key". Fără ea, aceste rute sunt dezactivate.
# ADMIN_API_KEY=

# Tiger Data (TimescaleDB) pentru statistici: "ore aglomerate" și panoul de cerere.
# Tiger Cloud -> serviciul vostru -> Connect -> "Service URL" (postgres://...).
# Doar date reale (clicurile de pe site). Fără ea, statisticile sunt ascunse.
# TIGER_DATABASE_URL=postgres://tsdbadmin:parola@xxxx.tsdb.cloud.timescale.com:5432/tsdb?sslmode=require
