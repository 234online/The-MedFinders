# Portul pe care rulează serverul backend Node.js
PORT=5000

# URL-ul frontend-ului (Vite rulează implicit pe http://localhost:5173)
FRONTEND_URL=http://localhost:5173

# Tipul bazei de date:
# - "json" : folosește fișierul generat din database/timisoara_clinics.sql
# - "postgres" / "mongodb" : opțiune pentru când baza de date va fi conectată live
DB_TYPE=json

# Connection string pentru baza de date PostgreSQL dacă va fi conectată direct:
# DATABASE_URL=postgresql://postgres:parola@localhost:5432/Clinics_db
